type Query {
    systemStatus: SystemStatus!
    """
    The name the operator configured for the site. Public because it is already
    substituted into every subscription config, and because the account
    dashboard puts it into the deep link that opens a client - which is the name
    the client then shows for the imported profile.
    """
    siteName: String!
    viewer: Viewer!
    deviceSessions: [DeviceSession!]!
    """Nodes this account can currently use, without client credentials."""
    viewerNodes: [ViewerNode!]!
    """Invitation codes owned by this account and their configured limits."""
    viewerInvitations: ViewerInvitationSummary!
    offerCatalog: [PlanOffer!]!
    planOffer(id: ID!): PlanOffer
    viewerEntitlement: SubscriptionEntitlement
    """
    The account's own daily traffic ledger, one row per node and day, starting
    31 days back. Recorded only where the billing actually charged the
    account, so the rows reconcile with the subscription counters.
    """
    viewerTrafficDaily: [ViewerTrafficDaily!]!
    """This account's referral commission settings and balance-ledger history."""
    viewerCommissionSummary: ViewerCommissionSummary!
    viewerCommissionLogs(page: Int = 0, limit: Int = 20): CommissionLogPage!
    """The current account's cash balance and movements since ledger cutover."""
    viewerBalanceSummary: ViewerBalanceSummary!
    viewerBalanceLogs(page: Int = 0, limit: Int = 20): BalanceLogPage!
    """
    The address this account's client subscribes to. It carries the account's
    credential, so it is only ever returned to the account itself.
    """
    viewerSubscriptionUrl: String
    """What a purchase would cost, itemised. Never mutates anything."""
    orderQuote(
        planId: ID!
        period: BillingPeriod!
        couponCode: String
    ): OrderQuote!
    viewerOrders: [ServiceOrder!]!
    """The ways one pending order can be paid for, each priced for it."""
    paymentOptions(tradeNo: String!): [PaymentOption!]!
    """The announcement carousel's content, shown ones only, carousel order."""
    viewerNotices: [Notice!]!
    """The help centre, grouped by category. Keyword filters title or body."""
    viewerKnowledge(language: String, keyword: String): [KnowledgeCategory!]!
    """One help article's full body; null when it does not exist or is hidden."""
    viewerKnowledgeArticle(id: ID!): KnowledgeArticle
    """Messages in the authenticated user's own human support conversation."""
    viewerSupportMessages: [SupportMessage!]!
}

type Mutation {
    revokeDeviceSession(id: ID!): Boolean!
    """
    Retires the current subscription link and answers with its replacement. The
    old address stops working as soon as this returns. The account's node
    credentials are rotated at the same time.
    """
    rotateSubscriptionCredential: String
    """Creates one invitation code for this account, subject to configured limits."""
    createInvitationCode: InvitationCode!
    updateViewerProfile(displayName: String!): Viewer!
    """
    Sets the account's own reminder-mail switches. Returns the whole viewer so
    the caller can refresh what it shows from one answer.
    """
    updateViewerReminders(remindExpire: Boolean!, remindTraffic: Boolean!): Viewer!
    placeOrder(
        planId: ID!
        period: BillingPeriod!
        couponCode: String
    ): ServiceOrder!
    cancelOrder(tradeNo: String!): Boolean!
    """
    Chooses how an order is being paid for and answers where to send the
    customer. Nothing is charged here - the browser is sent to the gateway, and
    the order is opened when the gateway's callback arrives.
    """
    checkoutOrder(tradeNo: String!, paymentMethodId: ID!): PaymentRedirect!
    """Send a text message to the authenticated user's human support conversation."""
    sendSupportMessage(content: String!): SupportMessage!
}

type SupportMessage {
    sender: String!
    content: String!
    createdAt: String!
}

type PaymentOption {
    id: ID!
    name: String!
    icon: String
    """What this method adds on top of the order's total."""
    handlingFee: String!
    """The order's total plus that fee: what will actually be charged."""
    payableAmount: String!
    currency: String!
    """The fixed part of the fee, in the currency's minor units; null when the method charges no fixed amount."""
    handlingFeeFixed: String
    """The percentage part of the fee, where 2.5 means 2.5 percent; null when the method charges no percentage."""
    handlingFeePercent: Float
}

type PaymentRedirect {
    """1 is a URL to send the browser to; 0 is a payload to render as a QR code."""
    type: Int!
    data: String!
}

type SystemStatus {
    status: String!
    timestamp: String!
}

type Viewer {
    id: ID!
    email: String!
    displayName: String!
    emailVerified: Boolean!
    roles: [String!]!
    createdAt: String!
    """Prepaid balance in minor units: money the customer has already paid in."""
    balanceMinor: String!
    """Whether the daily sweep may send this account the expiry reminder."""
    remindExpire: Boolean!
    """Whether the daily sweep may send this account the traffic reminder."""
    remindTraffic: Boolean!
}

type DeviceSession {
    id: ID!
    deviceLabel: String!
    createdAt: String!
    lastUsedAt: String!
    expiresAt: String!
    current: Boolean!
}

type ViewerNode {
    id: ID!
    name: String!
    protocol: String!
    """The current node traffic multiplier, including any scheduled override."""
    trafficRate: String!
    onlineStatus: ViewerNodeOnlineStatus!
    lastSeenAt: String
    tags: [String!]!
}

enum ViewerNodeOnlineStatus {
    ONLINE
    OFFLINE
    UNKNOWN
}

type InvitationCode {
    id: ID!
    code: String!
    createdAt: String!
}

type ViewerInvitationSummary {
    codes: [InvitationCode!]!
    availableCodeCount: Int!
    invitedUserCount: Int!
    generationLimit: Int!
    neverExpire: Boolean!
}

type PlanOffer {
    id: ID!
    name: String!
    description: String!
    tags: [String!]!
    planType: PlanType!
    transferLimitBytes: String!
    speedLimitMbps: Int
    resetPolicy: TrafficResetPolicy!
    renewable: Boolean!
    resettable: Boolean!
    purchaseLimitPerUser: Int
    capacityRemaining: Int
    newUserOffer: Boolean!
    prices: [PlanPrice!]!
}

type PlanPrice {
    period: BillingPeriod!
    amountMinor: String!
    currency: String!
    durationDays: Int
    monthCount: Int
}

type SubscriptionEntitlement {
    id: ID!
    planId: ID!
    planName: String!
    state: EntitlementState!
    transferLimitBytes: String!
    uploadedBytes: String!
    downloadedBytes: String!
    usedBytes: String!
    remainingBytes: String!
    usagePercent: Float!
    speedLimitMbps: Int
    resetPolicy: TrafficResetPolicy!
    startsAt: String!
    expiresAt: String
    nextResetAt: String
    isTrial: Boolean!
}

enum BillingPeriod {
    MONTHLY
    QUARTERLY
    HALF_YEARLY
    YEARLY
    TWO_YEARLY
    THREE_YEARLY
    ONETIME
    RESET_TRAFFIC
}

enum PlanType {
    SUBSCRIPTION
    TRAFFIC_PACKAGE
}

enum TrafficResetPolicy {
    FIRST_DAY_OF_MONTH
    MONTHLY_FROM_ACTIVATION
    NEVER
    FIRST_DAY_OF_YEAR
    YEARLY_FROM_ACTIVATION
}

enum EntitlementState {
    ACTIVE
    EXPIRED
    EXHAUSTED
    CANCELED
}

"""
One row of the account's daily traffic ledger. Byte counts are strings so a
64-bit value survives JSON. `billedBytes` is the upload plus download after
the node's rate multiplier was applied - the part that actually deducted
from the subscription - while the raw columns show what the node carried.
"""
type ViewerTrafficDaily {
    day: String!
    nodeName: String
    uploadBytes: String!
    downloadBytes: String!
    billedBytes: String!
}

type ViewerCommissionSummary {
    effectiveRatePercent: Int!
    commissionType: Int!
    firstPaymentOnly: Boolean!
    pendingMinor: String!
    confirmedPendingMinor: String!
    earnedMinor: String!
    autoConfirmEnabled: Boolean!
    distributionEnabled: Boolean!
    distributionL1: Int!
    distributionL2: Int!
    distributionL3: Int!
    payoutDestination: String!
}

type CommissionLogPage {
    items: [CommissionLog!]!
    totalCount: Int!
    page: Int!
    limit: Int!
}

type CommissionLog {
    id: ID!
    tradeNo: String!
    orderAmountMinor: String!
    commissionBaseMinor: String!
    amountMinor: String!
    level: Int!
    createdAt: String!
}

"""
The live account balance and its cash reconciliation. Credits include refunds;
the opening balance is a cutover anchor, not a new credit or order payment.
"""
type ViewerBalanceSummary {
    balanceMinor: String!
    openingBalanceMinor: String!
    totalCreditsMinor: String!
    totalDebitsMinor: String!
    recordedSince: String
}

type BalanceLogPage {
    items: [BalanceLog!]!
    totalCount: Int!
    page: Int!
    limit: Int!
}

"""
The rows are returned in persisted cash-mutation order. `canViewOrder` is true
only when the current account still owns the referenced order; commission
source orders remain read-only references.
"""
type BalanceLog {
    id: ID!
    type: String!
    """Signed minor units: inflows are positive and order payments negative."""
    amountMinor: String!
    balanceAfterMinor: String!
    currency: String!
    tradeNo: String
    createdAt: String!
    """True only while this account owns the referenced order."""
    canViewOrder: Boolean!
}

"""
Every amount is in minor units of `currency`, serialised as a string so a
64-bit value survives JSON. `totalAmount` is what is left to pay once the
coupon, the unused value of the plan being replaced, and the account balance
have all been applied.
"""
type OrderQuote {
    planId: ID!
    planName: String!
    period: BillingPeriod!
    orderType: OrderType!
    currency: String!
    originalAmount: String!
    discountAmount: String!
    surplusAmount: String!
    """The part of the surplus that outgrew this order and is owed back."""
    surplusCredit: String!
    balanceAmount: String!
    totalAmount: String!
    couponCode: String
    couponName: String
    accountBalanceMinor: String!
}

type ServiceOrder {
    id: ID!
    tradeNo: String!
    planId: ID!
    planName: String!
    period: BillingPeriod!
    orderType: OrderType!
    status: OrderStatus!
    currency: String!
    originalAmount: String!
    discountAmount: String!
    surplusAmount: String!
    surplusCredit: String!
    balanceAmount: String!
    totalAmount: String!
    """The surcharge the chosen payment method added, if one has been chosen."""
    handlingAmount: String!
    """The method this order was checked out with, if it has been."""
    paymentMethodId: ID
    gateway: String
    createdAt: String!
    paidAt: String
}

enum OrderType {
    NEW_PURCHASE
    RENEWAL
    UPGRADE
    RESET_TRAFFIC
}

enum OrderStatus {
    PENDING
    PROCESSING
    CANCELLED
    COMPLETED
    DISCOUNTED
}

type Notice {
    id: ID!
    title: String!
    content: String!
    imgUrl: String
    """Whether the dashboard may raise this notice beyond the carousel."""
    popup: Boolean!
    """When the notice was created, the carousel's published date."""
    publishedAt: String!
}

type KnowledgeCategory {
    category: String!
    articles: [KnowledgeArticleSummary!]!
}

type KnowledgeArticleSummary {
    id: ID!
    title: String!
    """When the article was last edited by the operator."""
    updatedAt: String!
}

type KnowledgeArticle {
    id: ID!
    title: String!
    category: String!
    language: String!
    body: String!
    updatedAt: String!
}
