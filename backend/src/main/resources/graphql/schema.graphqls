type Query {
    systemStatus: SystemStatus!
    viewer: Viewer!
    deviceSessions: [DeviceSession!]!
    offerCatalog: [PlanOffer!]!
    planOffer(id: ID!): PlanOffer
    viewerEntitlement: SubscriptionEntitlement
    """What a purchase would cost, itemised. Never mutates anything."""
    orderQuote(
        planId: ID!
        period: BillingPeriod!
        couponCode: String
    ): OrderQuote!
    viewerOrders: [ServiceOrder!]!
}

type Mutation {
    revokeDeviceSession(id: ID!): Boolean!
    updateViewerProfile(displayName: String!): Viewer!
    placeOrder(
        planId: ID!
        period: BillingPeriod!
        couponCode: String
    ): ServiceOrder!
    cancelOrder(tradeNo: String!): Boolean!
}

type SystemStatus {
    status: String!
    timestamp: String!
}

type Viewer {
    id: ID!
    email: String!
    displayName: String!
    emailVerified: Boolean!
    roles: [String!]!
    createdAt: String!
}

type DeviceSession {
    id: ID!
    deviceLabel: String!
    createdAt: String!
    lastUsedAt: String!
    expiresAt: String!
    current: Boolean!
}

type PlanOffer {
    id: ID!
    name: String!
    description: String!
    tags: [String!]!
    planType: PlanType!
    transferLimitBytes: String!
    speedLimitMbps: Int
    deviceLimit: Int
    resetPolicy: TrafficResetPolicy!
    renewable: Boolean!
    resettable: Boolean!
    purchaseLimitPerUser: Int
    capacityRemaining: Int
    prices: [PlanPrice!]!
}

type PlanPrice {
    period: BillingPeriod!
    amountMinor: String!
    currency: String!
    durationDays: Int
    monthCount: Int
}

type SubscriptionEntitlement {
    id: ID!
    planId: ID!
    planName: String!
    state: EntitlementState!
    transferLimitBytes: String!
    uploadedBytes: String!
    downloadedBytes: String!
    usedBytes: String!
    remainingBytes: String!
    usagePercent: Float!
    speedLimitMbps: Int
    deviceLimit: Int
    resetPolicy: TrafficResetPolicy!
    startsAt: String!
    expiresAt: String
    nextResetAt: String
}

enum BillingPeriod {
    MONTHLY
    QUARTERLY
    HALF_YEARLY
    YEARLY
    TWO_YEARLY
    THREE_YEARLY
    ONETIME
    RESET_TRAFFIC
}

enum PlanType {
    SUBSCRIPTION
    TRAFFIC_PACKAGE
}

enum TrafficResetPolicy {
    FIRST_DAY_OF_MONTH
    MONTHLY_FROM_ACTIVATION
    NEVER
    FIRST_DAY_OF_YEAR
    YEARLY_FROM_ACTIVATION
}

enum EntitlementState {
    ACTIVE
    EXPIRED
    EXHAUSTED
    CANCELED
}

"""
Every amount is in minor units of `currency`, serialised as a string so a
64-bit value survives JSON. `totalAmount` is what is left to pay once the
coupon, the unused value of the plan being replaced, and the account balance
have all been applied.
"""
type OrderQuote {
    planId: ID!
    planName: String!
    period: BillingPeriod!
    orderType: OrderType!
    currency: String!
    originalAmount: String!
    discountAmount: String!
    surplusAmount: String!
    """The part of the surplus that outgrew this order and is owed back."""
    surplusCredit: String!
    balanceAmount: String!
    totalAmount: String!
    couponCode: String
    couponName: String
    accountBalanceMinor: String!
}

type ServiceOrder {
    id: ID!
    tradeNo: String!
    planId: ID!
    planName: String!
    period: BillingPeriod!
    orderType: OrderType!
    status: OrderStatus!
    currency: String!
    originalAmount: String!
    discountAmount: String!
    surplusAmount: String!
    surplusCredit: String!
    balanceAmount: String!
    totalAmount: String!
    createdAt: String!
    paidAt: String
}

enum OrderType {
    NEW_PURCHASE
    RENEWAL
    UPGRADE
    RESET_TRAFFIC
}

enum OrderStatus {
    PENDING
    PROCESSING
    CANCELLED
    COMPLETED
    DISCOUNTED
}
