type Query {
    systemStatus: SystemStatus!
    viewer: Viewer!
    deviceSessions: [DeviceSession!]!
    adminAuditLogs(limit: Int = 50): [AdminAuditLog!]!
}

type Mutation {
    revokeDeviceSession(id: ID!): Boolean!
}

type SystemStatus {
    status: String!
    timestamp: String!
}

type Viewer {
    id: ID!
    email: String!
    displayName: String!
    emailVerified: Boolean!
    roles: [String!]!
    createdAt: String!
}

type DeviceSession {
    id: ID!
    deviceLabel: String!
    createdAt: String!
    lastUsedAt: String!
    expiresAt: String!
    current: Boolean!
}

type AdminAuditLog {
    id: ID!
    actorId: ID!
    actorEmail: String!
    action: String!
    httpMethod: String!
    requestPath: String!
    responseStatus: Int!
    outcome: String!
    durationMs: String!
    requestId: String
    ipAddress: String
    userAgent: String
    occurredAt: String!
}
