type Query {
    systemStatus: SystemStatus!
    viewer: Viewer!
    deviceSessions: [DeviceSession!]!
}

type Mutation {
    revokeDeviceSession(id: ID!): Boolean!
}

type SystemStatus {
    status: String!
    timestamp: String!
}

type Viewer {
    id: ID!
    email: String!
    displayName: String!
    emailVerified: Boolean!
    roles: [String!]!
    createdAt: String!
}

type DeviceSession {
    id: ID!
    deviceLabel: String!
    createdAt: String!
    lastUsedAt: String!
    expiresAt: String!
    current: Boolean!
}
